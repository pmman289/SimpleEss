$C = "../../Common.ui";

$C.@PageOverlay {
  $C.@Container {
    Anchor: (Width: 600, Height: 500);

    #Title {
      Group {
        $C.@Title {
          @Text = %tpaSettings.title;
        }
      }
    }

    #Content {
      LayoutMode: Top;

      /* ================= 设置项区域 ================= */
      Group {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        FlexWeight: 1;
        Padding: (Top: 10);

        $C.@CheckBoxWithLabel #EnableAutoAccept {
          @Text = %tpaSettings.enableAutoAccept;
          Padding: (Top: 4);
        }

        $C.@CheckBoxWithLabel #EnableAutoDeny {
          @Text = %tpaSettings.enableAutoDeny;
          Padding: (Top: 4);
        }

        $C.@CheckBoxWithLabel #EnableDisableTpa {
          @Text = %tpaSettings.enableDisableTpa;
          Padding: (Top: 4);
        }
      }

      /* ================= 底部分隔线 ================= */
      Group {
        Anchor: (Top: 6, Bottom: 6);
        OutlineColor: #93844c;
        OutlineSize: 0.5;
      }

      // 底部按钮区域
      Group #Footer {
        Anchor: (Horizontal: 0, Top: 15, Height: 40);
        LayoutMode: Center;

        Group {
          LayoutMode: Left;

          $C.@SecondaryTextButton #BackButton {
            @Anchor = (Width: 140, Height: 35);
            @Text = %tpaSettings.backButton;
          }
        }
      }
    }
  }
}

$C.@BackButton {}

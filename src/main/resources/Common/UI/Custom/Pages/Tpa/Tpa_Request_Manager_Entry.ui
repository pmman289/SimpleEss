$C = "../../Common.ui";

@ActionButtonStyle = TextButtonStyle(
  Default: (
    Background: $C.@DefaultSquareButtonDefaultBackground,
    LabelStyle: $C.@DefaultButtonLabelStyle
  ),
  Hovered: (
    Background: $C.@DefaultSquareButtonHoveredBackground,
    LabelStyle: $C.@DefaultButtonLabelStyle
  ),
  Pressed: (
    Background: $C.@DefaultSquareButtonPressedBackground,
    LabelStyle: $C.@DefaultButtonLabelStyle
  ),
  Disabled: (
    Background: $C.@DefaultSquareButtonDisabledBackground,
    LabelStyle: $C.@DefaultButtonDisabledLabelStyle
  ),
  Sounds: $C.@ButtonSounds,
);

Group {
  LayoutMode: Left;
  Anchor: (Left: 8, Right: 8, Height: 48);
  Padding: (Left: 8, Right: 8, Top: 6);

  // 左侧：名称 + 请求时间
  Group {
    LayoutMode: Top;
    Anchor: (Height: 36);

    Label #RequesterName {
      Text: "Pmman";
      Style: (
        FontSize: 16,
        RenderBold: true,
        TextColor: #ffffff
      );
    }

    Label #RequestTime {
      Text: "time";
      Style: (
        FontSize: 13,
        TextColor: #ffffff(0.65)
      );
    }
  }

  // 中间弹性占位
  Label {
    FlexWeight: 1;
  }

  // 右侧按钮组
  Group {
    LayoutMode: Left;
    Anchor: (Height: 28);

    $C.@TextButton #AcceptButton {
      Anchor: (Height: 28);
      Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
      Text: %tpaRequestManager.accept;
      Style: @ActionButtonStyle;
    }

    Group { Anchor: (Width: 8); }

    $C.@TextButton #DenyButton {
      Anchor: (Height: 28);
      Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
      Text: %tpaRequestManager.deny;
      Style: @ActionButtonStyle;
    }
  }
}

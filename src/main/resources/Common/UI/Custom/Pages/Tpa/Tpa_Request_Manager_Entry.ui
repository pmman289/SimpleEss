$C = "../../Common.ui";

@ActionButtonStyle = TextButtonStyle(
  Default: (
    Background: $C.@DefaultSquareButtonDefaultBackground,
    LabelStyle: $C.@DefaultButtonLabelStyle
  ),
  Hovered: (
    Background: $C.@DefaultSquareButtonHoveredBackground,
    LabelStyle: $C.@DefaultButtonLabelStyle
  ),
  Pressed: (
    Background: $C.@DefaultSquareButtonPressedBackground,
    LabelStyle: $C.@DefaultButtonLabelStyle
  ),
  Disabled: (
    Background: $C.@DefaultSquareButtonDisabledBackground,
    LabelStyle: $C.@DefaultButtonDisabledLabelStyle
  ),
  Sounds: $C.@ButtonSounds,
);

Group {
  Background: $C.@InputBoxBackground;
  LayoutMode: Left;
  Anchor: (Left: 8, Right: 8, Height: 48);
  Padding: (Left: 8, Right: 8, Top: 6);

  // 左侧：名称 + 请求时间
  Group {
    FlexWeight: 2;
    LayoutMode: Top;
    Anchor: (Height: 36);

    Label #RequesterName {
      Text: "Pmman";
      Style: (
        FontSize: 16,
        RenderBold: true,
        TextColor: #ffffff
      );
    }

    Label #RequestTime {
      Text: "time";
      Style: (
        FontSize: 13,
        TextColor: #ffffff(0.65)
      );
    }
  }

  Group {
    LayoutMode: CenterMiddle;
    Anchor: (Height: 24);
    FlexWeight: 3;
    Padding: (Right: 1);
    Label #TpaText {
      Text: "";
      Style: (
        FontSize: 11,
        TextColor: #00FF00,
        RenderBold: true
      );
    }
  }

  // 右侧按钮组
  Group {
    LayoutMode: Right;
    Anchor: (Height: 24);
    FlexWeight: 3;

    $C.@TextButton #AcceptButton {
      Anchor: (Height: 28, MaxWidth: 50);
      Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
      Text: %tpaRequestManager.accept;
      Style: @ActionButtonStyle;
    }

    Group { Anchor: (Width: 8); }

    $C.@TextButton #DenyButton {
      Anchor: (Height: 28, MaxWidth: 50);
      Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
      Text: %tpaRequestManager.deny;
      Style: @ActionButtonStyle;
    }
  }
}

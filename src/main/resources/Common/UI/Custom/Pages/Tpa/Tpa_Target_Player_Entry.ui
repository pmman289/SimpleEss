// Generated by Hytale UI Builder (https://hytale.ellie.au).
$C = "../../Common.ui";

@ActionButtonStyle = TextButtonStyle(
  Default: (
    Background: $C.@DefaultSquareButtonDefaultBackground,
    LabelStyle: $C.@DefaultButtonLabelStyle
  ),
  Hovered: (
    Background: $C.@DefaultSquareButtonHoveredBackground,
    LabelStyle: $C.@DefaultButtonLabelStyle
  ),
  Pressed: (
    Background: $C.@DefaultSquareButtonPressedBackground,
    LabelStyle: $C.@DefaultButtonLabelStyle
  ),
  Disabled: (
    Background: $C.@DefaultSquareButtonDisabledBackground,
    LabelStyle: $C.@DefaultButtonDisabledLabelStyle
  ),
  Sounds: $C.@ButtonSounds,
);

Group {
  LayoutMode: Left;
  Background: $C.@InputBoxBackground;
  Anchor: (Height: 48, Left: 8, Right: 8);
  Padding: (Left: 8, Right: 8, Top: 6);
  Group {
    LayoutMode: Top;
    Anchor: (Height: 36);
    FlexWeight: 2;
    Label #Name {
      Text: "Pmman";
      Style: (
        FontSize: 16,
        RenderBold: true,
        TextColor: #ffffff
      );
    }
    Label #WorldName {
      Text: "time";
      Style: (
        FontSize: 11,
        TextColor: #96a9be
      );
    }
  }
  Group {
    LayoutMode: CenterMiddle;
    Anchor: (Height: 24);
    FlexWeight: 3;
    Padding: (Right: 1);
    Label {
      Text: "";
      Style: (
        FontSize: 11,
        TextColor: #00FF00,
        RenderBold: true
      );
    }
  }
  Group {
    LayoutMode: Right;
    Anchor: (Height: 24);
    FlexWeight: 3;
    $C.@TextButton #TpaButton {
      Anchor: (Height: 28, MaxWidth: 50);
      Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
      Text: %tpaSelector.tpaButton;
      Style: @ActionButtonStyle;
    }
    Group {
      Anchor: (Width: 8);
    }
    $C.@TextButton #TpahereButton {
      Anchor: (Height: 28, MaxWidth: 50);
      Padding: (Left: 8, Right: 8, Top: 4, Bottom: 4);
      Text: %tpaSelector.tpahereButton;
      Style: @ActionButtonStyle;
    }
  }
}

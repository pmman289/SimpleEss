$C = "../../Common.ui";

$C.@PageOverlay {
  $C.@Container {
    Anchor: (Width: 400, Height: 500);

    #Title {
      $C.@Title {
        @Text = %kitSelector.title;
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 15);

      // 列表容器
      Group {
        Anchor: (Width: 370);
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        // 这里是 Java 动态注入 Entry 的地方
        Group #KitList {
          LayoutMode: Top;
        }
      }
      // --- 2. 新增的底部按钮区域 ---
      Group #Footer {
        Anchor: (Horizontal: 0, Top: 15, Height: 40); // Top: 15 增加与上方列表的间距
        LayoutMode: Center; // 按钮居中显示

        $C.@SecondaryTextButton #CancelButton {
          @Anchor = (Width: 150, Height: 35);
          Text: %kitSelector.cancelBtn;
        }
      }
    }
  }
}
$C.@BackButton {}